# Copy this file to macos/.release.env.local and replace the placeholders.
# macos/.release.env.local is gitignored and must never be committed.

export SKM_SIGNING_IDENTITY="${SKM_SIGNING_IDENTITY:-Developer ID Application: <Name> (<TEAM_ID>)}"
export SKM_NOTARY_KEY_PATH="${SKM_NOTARY_KEY_PATH:-/absolute/path/to/AuthKey_<KEY_ID>.p8}"
export SKM_NOTARY_KEY_ID="${SKM_NOTARY_KEY_ID:-<KEY_ID>}"
export SKM_NOTARY_ISSUER_ID="${SKM_NOTARY_ISSUER_ID:-<ISSUER_UUID>}"
export SKM_SPARKLE_PUBLIC_KEY="${SKM_SPARKLE_PUBLIC_KEY:-<SPARKLE_ED25519_PUBLIC_KEY>}"
export SKM_SPARKLE_PRIVATE_KEY_PATH="${SKM_SPARKLE_PRIVATE_KEY_PATH:-/absolute/path/to/skm.sparkle-key}"
